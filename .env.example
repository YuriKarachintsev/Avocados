# Copy to .env and fill in. Never commit .env — it holds secrets.

# --- Site -------------------------------------------------------------------
PORT=8080
NODE_ENV=production
# Your public address (must contain "careerstudioapp" per the brief)
PUBLIC_ORIGIN=https://careerstudioapp.com
# Extra origins allowed to call the API (comma-separated), e.g. https://www.careerstudioapp.com
ALLOWED_ORIGINS=https://www.careerstudioapp.com
# Set to 1 when running behind a reverse proxy / platform load balancer (Render, Railway, Fly, Nginx)
TRUST_PROXY=1
# Who may embed the editor in an iframe: 'self' (default), 'none', or your main site's origin
FRAME_ANCESTORS="'self'"
# Shown on the Profile page if the contact form is not configured
CONTACT_EMAIL=

# --- AI service (Replicate) — enables Outfit, Hair, Smile, HD cut-out, AI offices ---
# Create a token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Models (defaults shown). Edit model must accept: prompt, input_image, aspect_ratio, output_format, safety_tolerance
REPLICATE_EDIT_MODEL=black-forest-labs/flux-kontext-pro
REPLICATE_MATTE_MODEL=sprited/birefnet
REPLICATE_MATTE_VARIANT=portrait
REPLICATE_BACKGROUND_MODEL=black-forest-labs/flux-kontext-pro

# --- Cost guard ---------------------------------------------------------------
# Hard daily cap on estimated AI spend (USD). AI tools pause for the rest of the UTC day when reached.
DAILY_AI_BUDGET_USD=5
AI_REQUESTS_PER_HOUR_PER_IP=30
MAX_CONCURRENT_AI_JOBS=4
# Per-call estimates used by the cap — update if prices change
COST_EDIT_USD=0.04
COST_MATTE_USD=0.002
COST_BACKGROUND_USD=0.04

# --- Telegram (enquiries & applications) ------------------------------------
# 1) Talk to @BotFather → /newbot → copy the token here
TELEGRAM_BOT_TOKEN=
# 2) Message your bot (or add it to a group), then run: npm run telegram:chat-id
TELEGRAM_CHAT_ID=
CONTACT_REQUESTS_PER_HOUR_PER_IP=5
